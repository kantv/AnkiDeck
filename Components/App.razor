<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["AnkiDeck.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />

    @* The page is re-rendered by a full POST, so remember the scroll position of the notes
       table and restore it (or bring the new comparison row into view) after the reload. *@
    <script>
        (function () {
            var scrollKey = 'ankideck.scrollY';
            var previewKey = 'ankideck.focusPreview';
            var filterKey = 'ankideck.filterFocus';
            var savedScroll = null;
            var focusPreview = false;
            var pendingFilter = null;
            var filterTimer = null;

            try {
                savedScroll = sessionStorage.getItem(scrollKey);
                focusPreview = sessionStorage.getItem(previewKey) === '1';
                var rawFilter = sessionStorage.getItem(filterKey);
                pendingFilter = rawFilter ? JSON.parse(rawFilter) : null;
                sessionStorage.removeItem(scrollKey);
                sessionStorage.removeItem(previewKey);
                sessionStorage.removeItem(filterKey);
            } catch (error) {
                // sessionStorage may be unavailable in private modes; the page then simply starts at the top.
            }

            function rememberFilterFocus(input) {
                try {
                    sessionStorage.setItem(filterKey, JSON.stringify({
                        field: input.getAttribute('data-live-filter'),
                        caret: typeof input.selectionStart === 'number' ? input.selectionStart : 0
                    }));
                } catch (error) {
                }
            }

            document.addEventListener('input', function (event) {
                var input = event.target;
                if (!input || !input.matches || !input.matches('[data-live-filter]')) {
                    return;
                }

                clearTimeout(filterTimer);
                filterTimer = setTimeout(function () {
                    rememberFilterFocus(input);
                    if (input.form) {
                        input.form.requestSubmit();
                    }
                }, 450);
            });

            document.addEventListener('keydown', function (event) {
                var input = event.target;
                if (event.key !== 'Enter' || !input || !input.matches || !input.matches('[data-live-filter]')) {
                    return;
                }

                event.preventDefault();
                clearTimeout(filterTimer);
                rememberFilterFocus(input);
                if (input.form) {
                    input.form.requestSubmit();
                }
            });

            document.addEventListener('submit', function (event) {
                if (!event.target || event.target.id !== 'deck-actions-form') {
                    return;
                }

                try {
                    sessionStorage.setItem(scrollKey, String(window.scrollY));
                    var submitter = event.submitter;
                    if (submitter && typeof submitter.value === 'string' && submitter.value.indexOf('process:') === 0) {
                        sessionStorage.setItem(previewKey, '1');
                    }
                } catch (error) {
                }
            }, true);

            window.addEventListener('load', function () {
                window.requestAnimationFrame(function () {
                    if (pendingFilter) {
                        var filterInput = document.querySelector('[data-live-filter="' + pendingFilter.field + '"]');
                        if (filterInput) {
                            filterInput.focus({ preventScroll: true });
                            var caret = typeof pendingFilter.caret === 'number' ? pendingFilter.caret : filterInput.value.length;
                            try {
                                filterInput.setSelectionRange(caret, caret);
                            } catch (error) {
                            }
                        }
                    }

                    if (focusPreview) {
                        var preview = document.querySelector('tr.preview-row');
                        if (preview) {
                            preview.scrollIntoView({ block: 'center' });
                            return;
                        }
                    }

                    if (savedScroll !== null) {
                        var position = parseInt(savedScroll, 10);
                        if (!isNaN(position)) {
                            window.scrollTo(0, position);
                        }
                    }
                });
            });
        })();
    </script>
</body>

</html>
